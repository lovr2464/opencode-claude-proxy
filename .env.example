OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# passthrough: Claude Code owns the API key and sends it to the proxy.
# proxy: this .env owns OPENCODE_API_KEY and Claude Code may use a placeholder.
AUTH_MODE=passthrough
# OPENCODE_API_KEY=your-opencode-go-api-key

# Local proxy endpoint.
HOST=127.0.0.1
PORT=8787

# Model name shown in Claude Code and sent to OpenCode Go.
# When you switch models, update this file and Claude Code settings together.
DEFAULT_MODEL=kimi-k2.6
MODELS=kimi-k2.6

# Optional: map a displayed/requested model name to a different upstream name.
# Leave empty for identity mapping.
# MODEL_MAP=claude-sonnet-4-5=kimi-k2.6

# OpenCode Go/Kimi can reject forced tool_choice while thinking is enabled.
# auto-on-forced keeps Claude Code tool loops usable by downgrading any/tool to auto.
# Other values: passthrough, drop
TOOL_CHOICE_POLICY=auto-on-forced

REQUEST_TIMEOUT_MS=300000
LOG_LEVEL=info
