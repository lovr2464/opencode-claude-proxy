OPENCODE_API_KEY=your-opencode-go-api-key
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Local proxy endpoint.
HOST=127.0.0.1
PORT=8787

# Claude Code can request the Claude-facing model names below. MODEL_MAP sends
# them to the actual OpenAI-compatible model exposed by OpenCode Go.
DEFAULT_MODEL=claude-sonnet-4-5
MODELS=claude-sonnet-4-5,claude-opus-4-5,claude-haiku-4-5,kimi-k2.6
MODEL_MAP=claude-sonnet-4-5=kimi-k2.6,claude-opus-4-5=kimi-k2.6,claude-haiku-4-5=kimi-k2.6

# OpenCode Go/Kimi can reject forced tool_choice while thinking is enabled.
# auto-on-forced keeps Claude Code tool loops usable by downgrading any/tool to auto.
# Other values: passthrough, drop
TOOL_CHOICE_POLICY=auto-on-forced

REQUEST_TIMEOUT_MS=300000
LOG_LEVEL=info
